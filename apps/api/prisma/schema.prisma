generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ──────────────────────────────────────────────────────────────────────
enum UserRole {
  ADMIN
  HEAD_TEACHER
  ASSISTANT_TEACHER
  REGULAR_STUDENT
  EXAM_BATCH_STUDENT
}

enum AccountStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum StudentType {
  REGULAR
  EXAM_BATCH
}

enum StudentGroup {
  SCIENCE
  ARTS
  COMMERCE
}

enum Shift {
  MORNING
  DAY
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACTUAL
  VISITING
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
}

enum PaymentType {
  FULL
  PARTIAL
  FREE
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

enum NoticeTargetType {
  ALL
  CLASS
  BATCH
  URGENT
}

enum CalendarEventType {
  HOLIDAY
  EVENT
  EXAM
}

enum RoutineTargetType {
  CLASS
  BATCH
}

enum DayOfWeek {
  SUNDAY
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
}

enum SalaryStatus {
  PAID
  UNPAID
  PARTIAL
}

enum SubjectPaper {
  FIRST
  SECOND
  NONE
}

enum BatchStatus {
  UPCOMING
  ONGOING
  COMPLETED
}

// ── Models ─────────────────────────────────────────────────────────────────────

model User {
  id             String         @id @default(uuid())
  role           UserRole       @default(REGULAR_STUDENT)
  phone          String?        @unique
  email          String?        @unique
  passwordHash   String
  accountStatus  AccountStatus  @default(ACTIVE)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  teacher        Teacher?
  student        Student?
  loginHistory   LoginHistory[]
  auditLogs      AuditLog[]
  notificationPref NotificationPref?
}

model Teacher {
  id             String         @id @default(uuid())
  userId         String         @unique
  employeeId     String         @unique
  fullName       String
  designation    String
  employmentType EmploymentType @default(FULL_TIME)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  user           User           @relation(fields: [userId], references: [id])
  qualifications TeacherQualification[]
  subjects       TeacherSubject[]
  salaries       TeacherSalary[]
  leaves         LeaveRequest[] @relation("TeacherLeaves")
  routines       Routine[]
}

model TeacherQualification {
  id          String   @id @default(uuid())
  teacherId   String
  degree      String
  institution String
  year        Int
  teacher     Teacher  @relation(fields: [teacherId], references: [id])
}

model TeacherSubject {
  id        String   @id @default(uuid())
  teacherId String
  subjectId String
  classId   String
  teacher   Teacher  @relation(fields: [teacherId], references: [id])
  subject   Subject  @relation(fields: [subjectId], references: [id])
  class     Class    @relation(fields: [classId], references: [id])
}

model TeacherSalary {
  id            String       @id @default(uuid())
  teacherId     String
  month         Int
  year          Int
  amount        Float
  bonus         Float        @default(0)
  deduction     Float        @default(0)
  paymentStatus SalaryStatus @default(UNPAID)
  paidAt        DateTime?
  teacher       Teacher      @relation(fields: [teacherId], references: [id])
}

model Student {
  id          String       @id @default(uuid())
  userId      String       @unique
  studentId   String       @unique
  regNo       String?      @unique
  type        StudentType  @default(REGULAR)
  fullName    String
  dob         DateTime?
  gender      String?
  bloodGroup  String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  user        User         @relation(fields: [userId], references: [id])
  regularData RegularStudent?
  examData    ExamStudent?
  leaves      LeaveRequest[] @relation("StudentLeaves")
  results     Result[]
  meritLists  MeritList[]
  attendance  Attendance[]
  payments    Payment[]
}

model RegularStudent {
  id        String   @id @default(uuid())
  studentId String   @unique
  classId   String
  sectionId String?
  groupId   String?
  roll      Int?
  student   Student  @relation(fields: [studentId], references: [id])
  class     Class    @relation(fields: [classId], references: [id])
  section   Section? @relation(fields: [sectionId], references: [id])
  group     Group?   @relation(fields: [groupId], references: [id])
}

model ExamStudent {
  id         String   @id @default(uuid())
  studentId  String   @unique
  batchId    String
  targetExam String
  student    Student  @relation(fields: [studentId], references: [id])
  batch      Batch    @relation(fields: [batchId], references: [id])
}

model Class {
  id           String           @id @default(uuid())
  name         String
  academicYear String
  createdAt    DateTime         @default(now())

  sections     Section[]
  groups       Group[]
  subjects     Subject[]
  batches      Batch[]
  routines     Routine[]
  feeStructure FeeStructure[]
  regularStudents RegularStudent[]
  teacherSubjects TeacherSubject[]
}

model Section {
  id        String           @id @default(uuid())
  classId   String
  name      String
  class     Class            @relation(fields: [classId], references: [id])
  students  RegularStudent[]
}

model Group {
  id        String           @id @default(uuid())
  classId   String
  name      StudentGroup
  class     Class            @relation(fields: [classId], references: [id])
  students  RegularStudent[]
  subjects  Subject[]
}

model Subject {
  id        String           @id @default(uuid())
  classId   String
  groupId   String?
  name      String
  nameBn    String?
  code      String?
  paper     SubjectPaper     @default(NONE)
  totalMarks Int             @default(100)
  passMarks  Int             @default(33)
  isOptional Boolean         @default(false)

  class     Class            @relation(fields: [classId], references: [id])
  group     Group?           @relation(fields: [groupId], references: [id])
  teachers  TeacherSubject[]
  exams     Exam[]
}

model Batch {
  id        String          @id @default(uuid())
  classId   String
  name      String
  examName  String
  examYear  String
  status    BatchStatus     @default(UPCOMING)
  class     Class           @relation(fields: [classId], references: [id])
  sections  BatchSection[]
  students  ExamStudent[]
  routines  Routine[]
}

model BatchSection {
  id      String @id @default(uuid())
  batchId String
  name    String
  batch   Batch  @relation(fields: [batchId], references: [id])
}

model AcademicCalendar {
  id          String            @id @default(uuid())
  title       String
  date        DateTime
  endDate     DateTime?
  type        CalendarEventType
  description String?
}

model Routine {
  id         String            @id @default(uuid())
  targetType RoutineTargetType
  classId    String?
  batchId    String?
  teacherId  String
  day        DayOfWeek
  startTime  String
  endTime    String

  class      Class?   @relation(fields: [classId], references: [id])
  batch      Batch?   @relation(fields: [batchId], references: [id])
  teacher    Teacher  @relation(fields: [teacherId], references: [id])
}

model Exam {
  id          String            @id @default(uuid())
  name        String
  targetType  RoutineTargetType
  subjectId   String
  date        DateTime
  totalMarks  Int               @default(100)
  isPublished Boolean           @default(false)

  subject     Subject           @relation(fields: [subjectId], references: [id])
  results     Result[]
  meritLists  MeritList[]
}

model Result {
  id            String  @id @default(uuid())
  studentId     String
  examId        String
  obtainedMarks Float
  grade         String?
  gradePoint    Float?

  student       Student @relation(fields: [studentId], references: [id])
  exam          Exam    @relation(fields: [examId], references: [id])
}

model MeritList {
  id         String  @id @default(uuid())
  examId     String
  studentId  String
  rank       Int
  percentage Float
  grade      String?

  exam       Exam    @relation(fields: [examId], references: [id])
  student    Student @relation(fields: [studentId], references: [id])
}

model Attendance {
  id        String           @id @default(uuid())
  studentId String
  date      DateTime
  status    AttendanceStatus @default(PRESENT)

  student   Student          @relation(fields: [studentId], references: [id])
}

model Notice {
  id         String           @id @default(uuid())
  targetType NoticeTargetType
  title      String
  content    String
  isPinned   Boolean          @default(false)
  createdAt  DateTime         @default(now())
  expiresAt  DateTime?
}

model Message {
  id         String   @id @default(uuid())
  senderId   String
  receiverId String?
  groupId    String?
  content    String
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model FeeStructure {
  id           String  @id @default(uuid())
  classId      String
  academicYear String
  monthlyFee   Float

  class        Class   @relation(fields: [classId], references: [id])
}

model Payment {
  id          String      @id @default(uuid())
  studentId   String
  month       Int
  year        Int
  paidAmount  Float
  paymentType PaymentType @default(FULL)
  paidAt      DateTime    @default(now())

  student     Student     @relation(fields: [studentId], references: [id])
}

model SchoolSettings {
  id           String @id @default(uuid())
  name         String
  nameBn       String?
  logoUrl      String?
  primaryColor String?
}

model NotificationPref {
  id      String  @id @default(uuid())
  userId  String  @unique
  push    Boolean @default(true)
  email   Boolean @default(true)
  inApp   Boolean @default(true)

  user    User    @relation(fields: [userId], references: [id])
}

model LeaveRequest {
  id          String      @id @default(uuid())
  userId      String      // Can be teacher or student user ID, but we map to teacher/student below for ease
  teacherId   String?
  studentId   String?
  startDate   DateTime
  endDate     DateTime
  reason      String
  status      LeaveStatus @default(PENDING)
  createdAt   DateTime    @default(now())

  teacher     Teacher?    @relation("TeacherLeaves", fields: [teacherId], references: [id])
  student     Student?    @relation("StudentLeaves", fields: [studentId], references: [id])
}

model LoginHistory {
  id        String   @id @default(uuid())
  userId    String
  device    String?
  ipAddress String?
  loginAt   DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])
}

model AuditLog {
  id          String   @id @default(uuid())
  userId      String
  action      String
  targetTable String
  oldValue    String?
  newValue    String?
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id])
}
