# ==============================================================================
#  PANJEREE LMS — ENVIRONMENT VARIABLES TEMPLATE
#  When you're ready to connect Supabase, Firebase, and Cloudinary,
#  copy this file to `.env` in `apps/vite-ui/` and fill in your keys.
# ==============================================================================

# ── 1. SUPABASE (Database & Authentication) ──────────────────────────────────
# Found in: Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# ── 2. CLOUDINARY (Media & Photo Storage) ────────────────────────────────────
# Found in: Cloudinary Dashboard
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_unsigned_preset

# ── 3. FIREBASE (Push Notifications & FCM) ───────────────────────────────────
# Found in: Firebase Console -> Project Settings -> General
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
